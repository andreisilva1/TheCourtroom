# The Courtroom — optional configuration
#
# Everything works out of the box with `docker compose up` and NO .env file:
# these values are the same defaults baked into docker-compose.yml.
#
# Only create a .env (copy of this file) if a default host port collides with
# something already running on your machine — then change just that line.

# Host port the frontend is served on (browser opens this)
FRONTEND_PORT=5176

# Host port the backend API is published on.
# NOTE: this is baked into the frontend build, so changing it triggers a
# frontend rebuild (docker compose up --build).
API_PORT=8001

# Host ports for the supporting services (only needed if you want to reach
# them directly from the host for debugging — the app talks to them over the
# internal Docker network regardless).
QDRANT_PORT=6333
REDIS_PORT=6379

# Where the backend reaches your locally-installed Ollama.
# Default works for Docker Desktop (Mac/Windows) and Linux (via host-gateway).
# Only the required models (phi, nomic-embed-text) are pulled automatically on
# first run — you just need Ollama installed and running.
OLLAMA_HOST=http://host.docker.internal:11434
